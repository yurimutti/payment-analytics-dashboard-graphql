# ── Server-side only — NOT prefixed with VITE_, never bundled ────────────────
# Read by vite.config.ts (Node.js) to configure the dev-server proxy.
# In production, set these as environment variables in your hosting platform
# (Vercel, Netlify, Render, etc.) and configure an equivalent server-side proxy.
GRAPHQL_ENDPOINT=https://your-graphql-endpoint.com
API_KEY=pk_test_your_key_here

# ── Client-side — safe to expose in the bundle ────────────────────────────────
# The browser calls this proxy path; it never sees the real endpoint or API key.
VITE_GRAPHQL_ENDPOINT=/api/graphql
