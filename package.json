{
  "name": "payment-analytics-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "check:fix-unsafe": "biome check --write --unsafe src"
  },
  "dependencies": {
    "@apollo/client": "^3.13.4",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-router": "^1.120.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-devtools": "^1.120.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.5.0",
    "graphql": "^16.10.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.15.4",
    "@biomejs/biome": "2.4.16",
    "@graphql-codegen/cli": "^7.1.0",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@graphql-codegen/near-operation-file-preset": "^5.2.1",
    "@graphql-codegen/schema-ast": "^6.0.1",
    "@graphql-codegen/typescript-operations": "^6.0.3",
    "@tailwindcss/vite": "^4.1.8",
    "@tanstack/router-vite-plugin": "^1.120.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/ui": "^4.1.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.7"
  }
